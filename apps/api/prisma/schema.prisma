// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 用户模块 ====================

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  username  String
  password  String
  avatar    String?
  gender    Int       @default(2) // 0: 男, 1: 女, 2: 保密
  birthday  DateTime?
  balance   Float     @default(0)
  integral  Int       @default(0) // 积分
  role      String    @default("user") // user: 普通用户, admin: 管理员
  drawsSinceBigPrize Int @default(0) // 距上次抽中大奖的抽数（抽奖保底用）
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // 关联
  topUpRecords        TopUpRecord[]
  pointRecords        PointRecord[]
  lotteryRecords      LotteryRecord[]
  userCoupons         UserCoupon[]
  orders              Order[]
  checkInRecords      CheckInRecord[]
  addresses           Address[]
  paymentRecords      PaymentRecord[]
  queueTickets        QueueTicket[]
  supportConversation SupportConversation?

  @@map("users")
}

// 充值记录
model TopUpRecord {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  balance      Float // 充值金额
  giveBalance  Float    @default(0) // 赠送金额
  totalBalance Float // 充值后余额
  createdAt    DateTime @default(now())

  @@map("top_up_records")
}

// 充值选项配置
model MoneyOption {
  id        String   @id @default(cuid())
  money     Float // 充值金额
  giveMoney Float    @default(0) // 赠送金额
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("money_options")
}

// ==================== 菜单模块 ====================

// 菜品分类
model FoodCategory {
  id           String   @id @default(cuid())
  classifyName String
  icon         String?
  sortOrder    Int      @default(0)
  foods        Food[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("food_categories")
}

// 菜品
model Food {
  id         String       @id @default(cuid())
  classifyId String
  category   FoodCategory @relation(fields: [classifyId], references: [id])
  foodName   String
  foodImage  String?
  foodPrice  Float
  sortOrder  Int          @default(0)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("foods")
}

// ==================== 积分/抽奖模块 ====================

// 抽奖奖品配置
model LotteryPrize {
  id             String          @id @default(cuid())
  prizeName      String
  prizeImage     String
  prizeIntegral  Int             @default(0) // 0表示实物大奖，>0表示积分
  prizeValue     Float? // 奖品价值
  stock          Int             @default(0) // 库存
  weight         Int             @default(1) // 中奖权重（同类型奖品内部相对概率，默认 1 为均等）
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  lotteryRecords LotteryRecord[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("lottery_prizes")
}

// 抽奖记录
model LotteryRecord {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  prizeId      String
  prize        LotteryPrize @relation(fields: [prizeId], references: [id])
  costIntegral Int // 消耗积分
  createdAt    DateTime     @default(now())

  @@map("lottery_records")
}

// 积分商城商品
model Commodity {
  id                String   @id @default(cuid())
  commodityName     String
  commodityImage    String
  commodityIntegral Int // 所需积分
  stock             Int      @default(0)
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("commodities")
}

// 积分收支记录
model PointRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  integral  Int // 正数表示收入，负数表示支出
  isGet     Boolean // true: 收入, false: 支出
  remark    String
  createdAt DateTime @default(now())

  @@map("point_records")
}

// ==================== 优惠券模块 ====================

// 优惠券
model Coupon {
  id            String       @id @default(cuid())
  couponName    String
  couponAmount  Float // 优惠券金额
  consumeMoney  Float // 使用门槛
  couponUseTime DateTime // 有效期
  totalStock    Int          @default(0)
  remainStock   Int          @default(0)
  isActive      Boolean      @default(true)
  userCoupons   UserCoupon[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("coupons")
}

// 用户优惠券
model UserCoupon {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  couponId  String
  coupon    Coupon    @relation(fields: [couponId], references: [id])
  status    String    @default("unused") // unused: 未使用, used: 已使用
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("user_coupons")
}

// ==================== 签到模块 ====================

// 签到记录
model CheckInRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  integral  Int      @default(0) // 签到获得的积分
  createdAt DateTime @default(now())

  @@map("check_in_records")
}

// ==================== 支付模块 ====================

// 支付宝交易状态枚举
enum TradeStatus {
  NOT_PAY // 未支付（自定义）
  WAIT_BUYER_PAY // 等待买家付款
  TRADE_CLOSED // 交易关闭
  TRADE_SUCCESS // 交易成功（可退款）
  TRADE_FINISHED // 交易结束（不可退款）
}

// 支付记录
model PaymentRecord {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?      @relation(fields: [orderId], references: [id])
  outTradeNo  String      @unique // 商户订单号
  tradeNo     String? // 支付宝交易号
  amount      Float // 支付金额
  subject     String // 订单标题
  body        String? // 订单描述
  tradeStatus TradeStatus @default(NOT_PAY) // 交易状态
  payTime     DateTime? // 支付时间
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tradeNo])
  @@index([orderId])
  @@map("payment_records")
}

// ==================== 订单模块 ====================

// 订单
model Order {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  orderType      String // dine-in: 堂食, takeout: 外卖
  status         String          @default("pending") // pending, paid, completed, cancelled
  totalAmount    Float
  payAmount      Float // 实际支付金额
  address        String? // 外卖地址
  peopleCount    Int? // 就餐人数
  remark         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orderItems     OrderItem[]
  paymentRecords PaymentRecord[]

  @@map("orders")
}

// 订单明细
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id])
  foodId    String
  foodName  String
  foodPrice Float
  quantity  Int
  subtotal  Float

  @@map("order_items")
}

// 礼品卡
model GiftCard {
  id         String    @id @default(cuid())
  code       String    @unique // 兑换码
  amount     Float // 面额
  status     String    @default("active") // active / redeemed / expired
  redeemedBy String? // 兑换用户 ID
  redeemedAt DateTime? // 兑换时间
  createdAt  DateTime  @default(now())
  expiresAt  DateTime? // 过期时间

  @@map("gift_cards")
}

// ==================== 门店排队模块 ====================

model Store {
  id                 String              @id @default(cuid())
  name               String
  city               String
  address            String
  phone              String
  businessHours      String
  averageWaitMinutes Int                 @default(8)
  canTakeout         Boolean             @default(true)
  isActive           Boolean             @default(true)
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  queueCounters      StoreQueueCounter[]
  queueTickets       QueueTicket[]

  @@index([city, isActive])
  @@map("stores")
}

model StoreQueueCounter {
  storeId    String
  queueDate  String
  lastNumber Int    @default(0)
  store      Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, queueDate])
  @@map("store_queue_counters")
}

// 收货地址
model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiverName String // 收件人姓名
  phone        String // 联系电话
  region       String // 省市区
  detail       String // 详细地址
  isDefault    Boolean  @default(false) // 是否默认地址
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

model QueueTicket {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  queueDate   String
  queueType   String // small: 1-4 人桌, large: 5 人及以上
  number      Int
  partySize   Int
  status      String    @default("waiting") // waiting / called / completed / cancelled
  calledAt    DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([storeId, queueDate, queueType, number])
  @@index([userId, status])
  @@index([storeId, queueDate, queueType, status, number])
  @@map("queue_tickets")
}

// ==================== 在线客服模块 ====================

model SupportConversation {
  id                 String           @id @default(cuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String           @default("open") // open / closed
  lastMessagePreview String?
  lastMessageAt      DateTime?
  userUnreadCount    Int              @default(0)
  adminUnreadCount   Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  messages           SupportMessage[]

  @@index([status, lastMessageAt])
  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     String // user / admin
  content        String
  messageType    String              @default("text") // text / image / file
  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?
  attachmentMime String?
  readAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, senderRole, readAt])
  @@map("support_messages")
}
